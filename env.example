# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env al repositorio de GitHub.

TELEGRAM_TOKEN=your_telegram_token_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ID de Telegram del administrador (obtén el tuyo hablando con @userinfobot)
ADMIN_USER_ID=123456789

# Máximo de llamadas a la IA por usuario al día (0 = sin límite)
LIMITE_IA_DIARIO=50

# Opcional: personaliza el prompt del sistema sin tocar el código
# SYSTEM_PROMPT=Eres un asistente personal que responde siempre en español...

# Carpeta donde el bot guarda los documentos (pon la ruta del disco externo)
# Averíguala con: df -h   (ej: /mnt/disco, /media/usuario/DISCO)
DOCS_DIR=/mnt/disco/documentos
